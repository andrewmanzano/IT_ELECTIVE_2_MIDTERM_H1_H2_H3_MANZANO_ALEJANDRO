@model IEnumerable<AndrewDigitalStore.Models.Entities.Transaction>

@{
    ViewData["Title"] = "Transaction History";
}

<h2 class="text-warning mb-4">Completed Sales Ledger</h2>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info bg-dark text-info border-info">
        No transactions recorded yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle border-secondary">
            <thead>
                <tr class="table-active">
                    <th>Transaction ID</th>
                    <th>Date</th>
                    <th>Customer Name</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model)
                {
                    <tr>
                        <td class="font-monospace">@tx.TransactionId.ToString().Substring(0, 8)...</td>
                        <td>@tx.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@tx.CustomerName</td>
                        <td class="text-warning fw-bold">$@tx.TotalAmount.ToString("F2")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@tx.TransactionId" class="btn btn-sm btn-info">View Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}